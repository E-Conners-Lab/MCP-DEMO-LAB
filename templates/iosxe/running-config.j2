! Cisco IOS-XE configuration template
! Generated by network-mcp
!
version {{ ios_version | default('17.13') }}
service timestamps debug datetime msec
service timestamps log datetime msec
!
hostname {{ hostname }}
!
{% if enable_secret is defined %}
enable secret {{ enable_secret }}
{% endif %}
!
{% if aaa_enabled | default(false) %}
aaa new-model
aaa authentication login default local
aaa authorization exec default local
{% endif %}
!
{% if interfaces is defined %}
{% for iface in interfaces %}
interface {{ iface.name }}
{% if iface.description is defined %}
 description {{ iface.description }}
{% endif %}
{% if iface.ip is defined %}
 ip address {{ iface.ip }} {{ iface.mask | default('255.255.255.0') }}
{% endif %}
{% if iface.shutdown | default(false) %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
{% endif %}
{% if ospf is defined %}
router ospf {{ ospf.process_id | default(1) }}
{% if ospf.router_id is defined %}
 router-id {{ ospf.router_id }}
{% endif %}
{% for network in ospf.networks | default([]) %}
 network {{ network.prefix }} {{ network.wildcard }} area {{ network.area }}
{% endfor %}
!
{% endif %}
{% if bgp is defined %}
router bgp {{ bgp.asn }}
{% if bgp.router_id is defined %}
 bgp router-id {{ bgp.router_id }}
{% endif %}
{% for neighbor in bgp.neighbors | default([]) %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.asn }}
{% endfor %}
{% for network in bgp.networks | default([]) %}
 network {{ network.prefix }} mask {{ network.mask }}
{% endfor %}
!
{% endif %}
{% if ntp_servers is defined %}
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
{% endif %}
!
{% if logging_hosts is defined %}
{% for host in logging_hosts %}
logging host {{ host }}
{% endfor %}
{% endif %}
!
ip ssh version 2
!
line con 0
 logging synchronous
line vty 0 4
 transport input ssh
!
end
