! FRRouting configuration template
! Generated by network-mcp
frr version {{ frr_version | default('8.4.1') }}
frr defaults traditional
hostname {{ hostname }}
log syslog informational
no ipv6 forwarding
service integrated-vtysh-config
!
{% if interfaces is defined %}
{% for iface in interfaces %}
interface {{ iface.name }}
{% if iface.ip is defined %}
 ip address {{ iface.ip }}
{% endif %}
{% if iface.description is defined %}
 description {{ iface.description }}
{% endif %}
!
{% endfor %}
{% endif %}
{% if ospf is defined %}
router ospf
{% if ospf.router_id is defined %}
 ospf router-id {{ ospf.router_id }}
{% endif %}
{% for network in ospf.networks | default([]) %}
 network {{ network.prefix }} area {{ network.area }}
{% endfor %}
!
{% endif %}
{% if bgp is defined %}
router bgp {{ bgp.asn }}
{% if bgp.router_id is defined %}
 bgp router-id {{ bgp.router_id }}
{% endif %}
{% for neighbor in bgp.neighbors | default([]) %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.asn }}
{% endfor %}
{% for network in bgp.networks | default([]) %}
 network {{ network }}
{% endfor %}
!
{% endif %}
line vty
!
